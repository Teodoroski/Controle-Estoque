@model Controle_Estoque.Models.Produto
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Adicionar Produto";
}

<h1>Adicionar produto</h1>

<div>
<form asp-action="Adicionar" asp-controller="Estoque" method="POST">
    <div>
        <label asp-for="Nome">Nome Produto:</label>
        <input asp-for="Nome" />
    </div>

    <div>
        <label asp-for="Quantidade">Quantidade: </label>
        <input asp-for="Quantidade"/>
    </div>
    <div>
        <label asp-for="Preco">Preço: </label>
        <input asp-for="Preco"/>
    </div>
    <div>
            <label asp-for="CategoriaId">Categoria</label>

            <select asp-for="CategoriaId" class="form-control" 
                asp-items="@(new SelectList(ViewBag.Categorias, "Id", "Nome"))">

                <option value="">Selecione uma categoria</option>
            </select>

            <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>

    <button type="submit">Enviar</button>
</form>
</div>