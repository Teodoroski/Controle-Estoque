
@model IEnumerable<Controle_Estoque.Models.Produto>

@{
    ViewData["Title"] = "Listar";
}

<header>
    <h1 align="center">Produtos em estoque</h1>
    
    <form asp-controller="Estoque" asp-action="Listar" method="get">

    <div>
        <label>Produto</label>

        <input type="text"
               name="busca"
               class="form-control"
               placeholder="Digite o nome do produto" />
    </div>

    <div>
        <label>Categoria</label>

        <select name="categoriaId" class="form-control">

            <option value="">Todas as categorias</option>

            @foreach (var categoria in ViewBag.Categorias)
            {
                <option value="@categoria.Id">
                    @categoria.Nome
                </option>
            }

        </select>
    </div>

    <button type="submit" class="adicionar">
        Buscar
    </button>

</form>
</header>

<main>
    <h2><a asp-controller="Estoque" asp-action="Adicionar">Adicionar Produto</a></h2>
    <div class="table-wrapper">
        <table class="table custom-table table-sm">

            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Id)</th>
                    <th>@Html.DisplayNameFor(model => model.Nome)</th>
                    <th>Categoria</th>
                    <th>@Html.DisplayNameFor(model => model.Quantidade)</th>
                    <th>@Html.DisplayNameFor(model => model.Preco)</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nome</td>
                        <td>@item.Categoria.Nome</td>
                        <td>@item.Quantidade</td>
                        <td>
                            @(item.Preco.ToString(
                                "C",
                                System.Globalization.CultureInfo.GetCultureInfo("pt-BR")
                            ))
                        </td>
                        <td>
                            <a asp-controller="Estoque"
                               asp-action="Editar"
                               asp-route-id="@item.Id"
                               class="editar">
                                Editar
                            </a>

                            <a asp-controller="Estoque"
                               asp-action="Deletar"
                               asp-route-id="@item.Id"
                               class="deletar"
                               onclick="return confirm('Tem certeza que deseja deletar o produto @item.Nome?');">
                                Deletar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>