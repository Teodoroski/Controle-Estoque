
@model IEnumerable<Controle_Estoque.Models.Produto>

@{
    ViewData["Title"] = "Listar";
}

<header>
    <h1 align="center">Produtos em estoque</h1>
    <h2><a asp-controller="Estoque" asp-action="Adicionar">Adicionar Produto</a></h2>
</header>

<main>
    <div class="table-wrapper">

        <table class="table custom-table table-sm">

            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Id)</th>
                    <th>@Html.DisplayNameFor(model => model.Nome)</th>
                    <th>@Html.DisplayNameFor(model => model.Quantidade)</th>
                    <th>@Html.DisplayNameFor(model => model.Preco)</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>@item.Id</td>

                        <td>@item.Nome</td>

                        <td>@item.Quantidade</td>

                        <td>
                            @(item.Preco.ToString(
                                "C",
                                System.Globalization.CultureInfo.GetCultureInfo("pt-BR")
                            ))
                        </td>

                        <td>

                            <a asp-controller="Estoque"
                               asp-action="Editar"
                               asp-route-id="@item.Id"
                               class="editar">
                                Editar
                            </a>

                            <a asp-controller="Estoque"
                               asp-action="Deletar"
                               asp-route-id="@item.Id"
                               class="deletar">
                                Deletar
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
</main>