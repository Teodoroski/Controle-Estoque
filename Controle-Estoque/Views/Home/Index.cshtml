@model IEnumerable<Controle_Estoque.Models.Produto>
@{
    ViewData["Title"] = "Início";
}

<div>
    <h1 align="center">Bem - vindo, @ViewBag.Nome!</h1>
</div>

<div class="dashboard-cards">

    <a asp-controller="Estoque"
       asp-action="Listar"
       class="dashboard-card card-produtos">

        <h3>Produtos cadastrados</h3>
        <p>@ViewBag.Quant</p>
    </a>
    
    <a asp-controller="Estoque" 
       asp-action="Listar"
       class="dashboard-card card-unidades">

        <h3>Unidades em estoque</h3>
        <p>@ViewBag.Unid</p>
    </a>

    <a asp-controller="Estoque" 
       asp-action="Listar"
       asp-route-estoqueBaixo="true"
       class="dashboard-card card-baixo">

        <h3>Estoque baixo</h3>
        <p>@ViewBag.Baixo</p>
    </a>
</div>

<div class="dashboard-cards">
    <div class="dashboard-card card-total-estoque">
        <h3>Valor total do estoque:</h3>
        <p>
            @String.Format(
            System.Globalization.CultureInfo.GetCultureInfo("pt-BR"),
        "{0:C}",
        ViewBag.VTotal)
        </p>
    </div>
</div>