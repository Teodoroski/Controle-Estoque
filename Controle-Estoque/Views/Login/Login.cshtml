@model Controle_Estoque.Models.Usuario

@{
    ViewData["Title"] = "Login";
    Layout = "_LoginLayout";
}

<div class="login-box">
<h1>Login</h1>

    <form asp-controller="Login" asp-action="Login" method="POST">
    
       <div>
          <label asp-for="Nome">Nome: </label>
          <input asp-for="Nome" />
      </div>
    
       <div>
           <label asp-for="Senha">Senha: </label>
            <input asp-for="Senha" type="password" />
        </div>
    
        <button type="submit">Entrar</button>
    </form>
    <p>ou</p>
    <p><a asp-controller="Login" asp-action="Cadastrar">
        Cadastrar-se
    </a></p>
</div>