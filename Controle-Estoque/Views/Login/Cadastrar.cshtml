@model Controle_Estoque.Models.Usuario

@{
    ViewData["Title"] = "Cadastrar";
}

<h1 align="center" class="display-3">Cadastrar-se</h1>

<div align="center">
    <form asp-action="Cadastrar" asp-controller="Login" method="POST">
        <div class="col-form-label">
            <label asp-for="Nome">Nome: </label>
            <input asp-for="Nome"/>
        </div>

        <div class="col-form-label">
            <label asp-for="Email">Email: </label>
            <input asp-for="Email" type="email"/>
        </div>
        <div class ="col-form-label">
            <label asp-for="Senha">Senha: </label>
            <input asp-for="Senha" type="Senha"/>
        </div>

        <button type="submit">Cadastrar</button>
        <a asp-action="Login">Login</a>
    </form>
</div>
