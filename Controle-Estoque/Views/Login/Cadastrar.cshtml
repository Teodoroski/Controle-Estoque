@model Controle_Estoque.Models.Usuario

@{
    ViewData["Title"] = "Cadastrar";
    Layout = "_LoginLayout";
}

<div class="login-box">
<h1>Cadastrar-se</h1>

    <form asp-action="Cadastrar" asp-controller="Login" method="POST">
        <div>
            <label asp-for="Nome">Nome: </label>
            <input asp-for="Nome"/>
        </div>

        <div>
            <label asp-for="Email">Email: </label>
            <input asp-for="Email" type="email"/>
        </div>

        <div>
            <label asp-for="Senha">Senha: </label>
            <input asp-for="Senha" type="Senha"/>
        </div>

        <button type="submit">Cadastrar</button>
    </form>
    <p><a asp-action="Login">Voltar para página de Login</a></p>
</div>