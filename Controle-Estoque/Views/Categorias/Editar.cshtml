@model Controle_Estoque.Models.Categoria;
@{
    ViewData["Title"] = "Editar Categoria";
}

<h1>Editar Categoria</h1>

<form asp-action="Editar" asp-controller="Categorias" method="POST">
    <label asp-for="Nome">Nome: </label>
    <input asp-for="Nome"/>

    <button type="submit">Editar</button>
</form>