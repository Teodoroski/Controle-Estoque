@model IEnumerable<Controle_Estoque.Models.Categoria>
@{
    ViewData["Title"] = "Listar Categorias";
}
<header>
    <h1 align="center">Categorias</h1>
</header>
<main>

    <!-- A mensagem de erro fica aqui -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <h2><a asp-action="Adicionar" asp-controller="Categorias">Adicionar nova categoria</a></h2>

    <div class="table-wrapper">
    <table class="table custom-table table-sm">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Id)</th>
                <th>@Html.DisplayNameFor(model => model.Nome)</th>
                <th>Ação</th>
            </tr>
        </thead>
        <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nome</td>
                        <td><a asp-action="Editar"
                               asp-controller="Categorias"
                               asp-route-id="@item.Id"
                               class="editar">Editar</a>

                            <form asp-action="Deletar"
                                  asp-controller="Categorias"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  onsubmit="return confirm('Tem certeza que deseja deletar a categoria @item.Nome?');">

                                <button type="submit" class="deletar">
                                    Deletar
                                </button>
                            </form>
                        </td> 
                    </tr>
                }
        </tbody>
    </table>
    </div>
</main>