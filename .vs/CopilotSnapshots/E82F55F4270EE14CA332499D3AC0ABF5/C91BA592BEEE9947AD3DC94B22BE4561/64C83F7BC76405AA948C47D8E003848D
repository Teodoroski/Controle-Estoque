```css
/* ================================================= */
/* CONFIGURAÇÕES GERAIS */
/* ================================================= */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


html,
body {
    width: 100%;
    height: 100%;
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f4f6f8;
    overflow: hidden;
}


/* ================================================= */
/* LAYOUT PRINCIPAL */
/* ================================================= */

.layout {
    width: 100%;
    height: 100vh;
    display: flex;
    background-color: #f4f6f8;
}



/* ================================================= */
/* BARRA LATERAL ESQUERDA */
/* ================================================= */

.sidebar {
    width: 240px;
    height: 100vh;
    background-color: #1e293b;
    color: white;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}



/* ================================================= */
/* LOGO */
/* ================================================= */

.logo {
    height: 106px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 22px;
    border-bottom: 1px solid #334155;
}


.logo-icon {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: #2563eb;
    font-size: 21px;
}


.logo h2 {
    font-size: 18px;
    line-height: 1.2;
    color: white;
}



/* ================================================= */
/* MENU ESQUERDO */
/* ================================================= */

.menu {
    display: flex;
    flex-direction: column;
    padding: 25px 14px;
}


.menu-item {
    height: 50px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 14px;
    margin-bottom: 7px;
    border-radius: 8px;
    color: #e2e8f0;
    text-decoration: none;
    font-size: 16px;
    transition: 0.2s;
}


    .menu-item:hover {
        background-color: #334155;
        color: white;
    }


.menu-icon {
    width: 24px;
    display: flex;
    justify-content: center;
    font-size: 17px;
}



/* ================================================= */
/* BOTÃO SAIR */
/* ================================================= */

.sidebar-bottom {
    margin-top: auto;
    padding: 15px 14px;
    border-top: 1px solid #334155;
}


.logout {
    height: 45px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 14px;
    color: #e2e8f0;
    text-decoration: none;
    border-radius: 8px;
    transition: 0.2s;
}


    .logout:hover {
        background-color: #334155;
        color: white;
    }



/* ================================================= */
/* ÁREA PRINCIPAL */
/* ================================================= */

.main {
    flex: 1;
    height: 100vh;
    min-width: 0;
    display: flex;
    flex-direction: column;
    background-color: #f4f6f8;
    /*
       Espaço reservado para a barra
       lateral direita.
    */

    margin-right: 280px;
}
.main1 {
    flex: 1;
    height: 100vh;
    min-width: 0;
    display: flex;
    flex-direction: column;
    background-color: #f4f6f8;
}



/* ================================================= */
/* BARRA SUPERIOR */
/* ================================================= */

.topbar {
    height: 70px;
    flex-shrink: 0;
    background-color: white;
    border-bottom: 1px solid #dfe3e8;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 30px;
}


.page-title {
    display: flex;
    align-items: center;
    gap: 18px;
}


    .page-title h3 {
        font-size: 20px;
        color: #1e293b;
    }


.menu-button {
    font-size: 25px;
    color: #334155;
    cursor: pointer;
}


.usuario {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #475569;
    font-size: 15px;
}


.usuario-icon {
    font-size: 20px;
}



/* ================================================= */
/* CONTEÚDO CENTRAL */
/* ================================================= */

.content {
    flex: 1;
    padding: 40px;
    background-color: #f4f6f8;
    overflow-y: auto;
}



/* ================================================= */
/* BARRA LATERAL DIREITA */
/* ================================================= */

.rightbar {
    position: fixed;
    top: 0;
    right: 0;
    width: 280px;
    height: 100vh;
    background-color: white;
    border-left: 1px solid #dfe3e8;
    padding: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 100;
}



/* ================================================= */
/* TÍTULO DA BARRA DIREITA */
/* ================================================= */

.rightbar-title {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding-bottom: 25px;
    border-bottom: 1px solid #e1e5e9;
    margin-bottom: 32px;
}


    .rightbar-title h3 {
        font-size: 20px;
        color: #1e293b;
    }


.rightbar-icon {
    font-size: 22px;
}



/* ================================================= */
/* BOTÕES DA BARRA DIREITA */
/* ================================================= */

.acao {
    width: 100%;
    min-height: 105px;
    margin-bottom: 25px;
    border-radius: 10px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: 0.2s;
}


.acao-icon {
    font-size: 27px;
}


.acao-text {
    font-size: 16px;
    font-weight: 600;
}



/* ================================================= */
/* ADICIONAR PRODUTO */
/* ================================================= */

.adicionar {
    color: #198754;
    border: 1px solid #b7dfc9;
    background-color: #f4fbf7;
}


    .adicionar:hover {
        background-color: #e2f5e9;
        transform: translateY(-2px);
    }



/* ================================================= */
/* ATUALIZAR PRODUTO */
/* ================================================= */

.atualizar {
    color: #0d6efd;
    border: 1px solid #b6d4fe;
    background-color: #f3f7ff;
}


    .atualizar:hover {
        background-color: #e3efff;
        transform: translateY(-2px);
    }



/* ================================================= */
/* DELETAR PRODUTO */
/* ================================================= */

.deletar {
    color: #dc3545;
    border: 1px solid #f1aeb5;
    background-color: #fff5f5;
}


    .deletar:hover {
        background-color: #ffe5e5;
        transform: translateY(-2px);
    }



/* ================================================= */
/* BARRA DE ROLAGEM */
/* ================================================= */

.content::-webkit-scrollbar {
    width: 8px;
}


.content::-webkit-scrollbar-track {
    background-color: #f1f1f1;
}


.content::-webkit-scrollbar-thumb {
    background-color: #cbd5e1;
    border-radius: 10px;
}


    .content::-webkit-scrollbar-thumb:hover {
        background-color: #94a3b8;
    }



/* ================================================= */
/* RESPONSIVIDADE */
/* ================================================= */

@media (max-width: 1000px) {

    .sidebar {
        width: 200px;
    }


    .rightbar {
        width: 230px;
        padding: 20px;
    }


    .main {
        margin-right: 240px;
    }


    .logo h2 {
        font-size: 15px;
    }


    .content {
        padding: 25px;
    }
}


@media (max-width: 750px) {

    .sidebar {
        width: 70px;
    }


    .logo {
        justify-content: center;
        padding: 0;
    }


        .logo h2 {
            display: none;
        }


    .logo-icon {
        width: 40px;
        height: 40px;
    }


    .menu-item {
        justify-content: center;
        padding: 0;
    }


        .menu-item span:last-child {
            display: none;
        }


    .logout {
        justify-content: center;
        padding: 0;
    }


        .logout span:last-child {
            display: none;
        }


    .rightbar {
        width: 200px;
        padding: 20px;
    }


    .main {
        margin-right: 200px;
    }


    .acao {
        min-height: 85px;
    }


    .acao-text {
        font-size: 13px;
    }
}
```
